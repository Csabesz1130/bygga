    { "id": "T1", "label": "B", "name": "Planter tray", "size": [740, 150, 300], "pos": [0, 200, 0], "material": "wood" },
    { "id": "T2", "label": "B", "name": "Planter tray", "size": [740, 150, 300], "pos": [0, 600, 0], "material": "wood" },
    { "id": "T3", "label": "B", "name": "Planter tray", "size": [740, 150, 300], "pos": [0, 1000, 0], "material": "wood" },
    { "id": "R1", "label": "C", "name": "Back rail", "size": [740, 60, 20], "pos": [0, 1170, -165], "material": "wood" },
    { "id": "R2", "label": "D", "name": "Front foot rail", "size": [740, 60, 20], "pos": [0, 30, 165], "material": "wood" },
    { "id": "W", "label": "E", "name": "Wall bracket", "size": [80, 40, 20], "pos": [0, 1170, -185], "material": "metal" }
